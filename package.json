{
  "name": "destop-stockridge",
  "version": "0.1.0",
  "private": true,
  "author": "StockRidge",
  "description": "StockRidge desktop shell. The web app stays the UI. SQLite replaces IndexedDB on this computer. Workers remains the sync gateway.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "stage": "node tools/stage-ui.js",
    "archive": "node tools/stage-ui.js && node tools/archive.js",
    "publish-update": "node tools/publish-update.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "11.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.stockridge.desktop",
    "productName": "StockRidge",
    "artifactName": "StockRidge-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/stockridge",
        "to": "stockridge"
      },
      {
        "from": "build/desktop-config.json",
        "to": "desktop-config.json"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.business"
    }
  }
}
