# Worker's public origin. The desktop app never holds a Turso token.
# Sample is the demonstration. A client's own Worker URL goes here.
STOCKRIDGE_ORIGIN=https://sample.stockridge.workers.dev

# Checkout that contains public/. Defaults to the sibling folder ../stockridge.
# STOCKRIDGE_ROOT=C:\StockRidgeClients\NorthlineStores\stockridge

# Stable local port. A random port would forget the signed-in session.
# STOCKRIDGE_PORT=47321
